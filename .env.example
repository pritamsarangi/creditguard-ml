# -----------------------------
# Database
# -----------------------------
# You can either provide DATABASE_URL directly or use the local SQL Server
# settings below. Do not commit your real .env file.

DATABASE_URL=

DB_SERVER=localhost\SQLEXPRESS
DB_NAME=CreditGuard
DB_DRIVER=ODBC Driver 18 for SQL Server

# -----------------------------
# ML model
# -----------------------------
MODEL_PATH=artifacts/model_stronger_notebook.joblib
MODEL_METADATA_PATH=artifacts/model_stronger_notebook_metadata.json

MODEL_VERSION=notebook_v4
MODEL_NAME=xgboost_compact_8

CLASSIFICATION_THRESHOLD=0.25

# Presentation-only risk bands
LOW_RISK_MAX=0.20
HIGH_RISK_MIN=0.40

# Local development
CORS_ORIGINS=*
