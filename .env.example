
# =====================================
# CreditGuard Environment Configuration
# =====================================
# Copy this file to .env for local development.
# Never commit .env or real credentials.

# -------------------------------------
# DATABASE
# -------------------------------------

# Local development: SQL Server Express
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=CreditGuard
DB_DRIVER=ODBC Driver 18 for SQL Server

# Cloud deployment: Neon PostgreSQL
# Uncomment and replace with your private Neon URL
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require

# -------------------------------------
# AUTHENTICATION
# -------------------------------------

# Generate unique strong random secrets.
OTP_SECRET_KEY=replace_with_random_secret
JWT_SECRET_KEY=replace_with_another_random_secret

# -------------------------------------
# EMAIL OTP - BREVO
# -------------------------------------

BREVO_API_KEY=replace_with_brevo_api_key
BREVO_SENDER_EMAIL=verified-sender@example.com

# -------------------------------------
# CORS
# -------------------------------------

# Comma-separated allowed Web origins.
# Local development example:
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Production example:
# CORS_ORIGINS=https://your-creditguard-web-domain.com

# -------------------------------------
# ML MODEL
# -------------------------------------

MODEL_PATH=artifacts/model_stronger_notebook.joblib
MODEL_METADATA_PATH=artifacts/model_stronger_notebook_metadata.json

MODEL_NAME=xgboost_compact_8
MODEL_VERSION=notebook_v4

CLASSIFICATION_THRESHOLD=0.25
LOW_RISK_MAX=0.20
HIGH_RISK_MIN=0.40
