.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# Dataset generated/downloaded locally
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained model binaries
artifacts/*.joblib
artifacts/*.pkl
artifacts/*.pickle
ml_pipeline/artifacts/*.joblib
ml_pipeline/artifacts/*.pkl
ml_pipeline/artifacts/*.pickle

# Keep folders / lightweight metadata if present
!artifacts/.gitkeep

# Generated ML outputs
reports/*.png
reports/*.json
ml_pipeline/catboost_info/

# Project archives
*.zip
*.7z
*.rar

# Flutter / Dart generated files
flutter_app/.dart_tool/
flutter_app/build/
flutter_app/.packages
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.pub-cache/
flutter_app/android/.gradle/
flutter_app/android/local.properties
flutter_app/android/app/debug/
flutter_app/android/app/profile/
flutter_app/android/app/release/
flutter_app/ios/Pods/
flutter_app/ios/.symlinks/
flutter_app/ios/Flutter/ephemeral/
flutter_app/ios/Flutter/Generated.xcconfig
flutter_app/ios/Flutter/flutter_export_environment.sh
flutter_app/macos/Flutter/ephemeral/

# Keep pubspec.lock for application reproducibility
# flutter_app/pubspec.lock is intentionally tracked

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Logs
*.log
